# ---- Required for server deployments --------------------------------------
# Master key that encrypts provider keys and cached responses (keep it secret, back it up).
# Generate one with:  openssl rand -hex 32
TOKENSIP_SECRET=

# Admin password for the dashboard (min 10 chars). If unset, a one-time setup
# token is printed to the logs on first start.
TOKENSIP_ADMIN_PASSWORD=

# ---- Optional ---------------------------------------------------------------
# local | server   (server: no provider-key passthrough, HSTS, binds 0.0.0.0)
TOKENSIP_MODE=server
# off | safe | balanced | aggressive | extreme
TOKENSIP_PROFILE=balanced
# Set to true when running behind nginx / Caddy / Traefik / a load balancer
TOKENSIP_TRUST_PROXY=false
# Allow clients to send their own provider keys instead of TokenSip keys
TOKENSIP_ALLOW_PASSTHROUGH=false
# Comma-separated origins allowed to call the proxy from browsers
TOKENSIP_CORS_ORIGINS=
# Enables GET /metrics (Prometheus) with "Authorization: Bearer <token>"
TOKENSIP_METRICS_TOKEN=
TOKENSIP_BODY_LIMIT_MB=50
TOKENSIP_UPSTREAM_TIMEOUT_MS=600000
TOKENSIP_LOG_LEVEL=info

# ---- Provider keys (optional; can also be added in the dashboard) -----------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
